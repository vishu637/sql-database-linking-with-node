<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>to print all the user</title>
    <style>
        table,tr,td,th{
            border: 1px solid black;
        }
    </style>
</head>
<body>
    <table>
        <tr>
            <th> Id </th>
            <th>Username</th>
            <th>Eamil</th>
            <th> Edit </th>
        </tr>
        <% for(user of users){ %>
          <tr>
             <td><%= user.id %></td>
            <td><%= user.username %></td>
            <td><%= user.email %></td>
            <td>
            <form method="GET" action="/user/<%= user.id %>/edit">
            <button>Edit User</button>
            </form>
            </td>
            <td>
            <form method="GET" action="/user/<%= user.id %>/delete">
                <button>DELETE</button>
            </form>
            </td>
     
        </tr>
       <% }  %>
    </table>
    <form method="GET" action="/user/new">
        <button class="to add user">ADD USER</button>
    </form>
    
</body>
</html>